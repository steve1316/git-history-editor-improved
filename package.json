{
    "name": "git-history-editor-improved",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "9",
        "@mui/material": "9",
        "@mui/x-date-pickers": "9",
        "@tanstack/react-virtual": "^3.14.12",
        "luxon": "^3.7.2",
        "react": "19",
        "react-dom": "19",
        "zundo": "^2.3.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/luxon": "^3.7.5",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.9.6",
        "typescript": "5",
        "typescript-eslint": "^8.70.0",
        "vite": "8",
        "vitest": "^5.0.0"
    }
